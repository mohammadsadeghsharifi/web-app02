{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app02",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "5ee3d8f5-7145-43ad-948f-5a52400ab16b","database_name": "mohammad" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b407597b393e401483b06e772a27d0db" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
